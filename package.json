{
  "name": "iraq-warfare",
  "version": "0.0.1-beta",
  "description": "Browser-based multiplayer team deathmatch shooter set in Iraq",
  "main": "desktop/main.js",
  "scripts": {
    "start": "electron .",
    "server": "node server.js",
    "package": "electron-packager . IraqWarfare --platform=win32 --arch=x64 --out=dist --overwrite --icon=desktop/icon.ico --app-copyright=\"Iraq Warfare\" --app-version=0.0.1 --build-version=0.0.1 --ignore=\"^/dist\" --ignore=\"^/steam\" --ignore=\"^/[.]claude\" --ignore=\"node_modules/three/(examples|src|docs)\" --prune=true"
  },
  "dependencies": {
    "steamworks.js": "^0.4.0",
    "three": "^0.170.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@electron/packager": "^18.4.4",
    "electron": "^33.4.11"
  },
  "productName": "Iraq Warfare",
  "steamAppId": 480
}
