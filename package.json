{
  "name": "the-strait",
  "version": "0.0.1-beta",
  "description": "The Strait! - multiplayer team deathmatch shooter: U.S. Marines vs Iranian Forces at a port on the Strait of Hormuz",
  "main": "desktop/main.js",
  "scripts": {
    "start": "electron .",
    "server": "node server.js",
    "package": "electron-packager . TheStrait --platform=win32 --arch=x64 --out=dist --overwrite --icon=desktop/icon.ico --app-copyright=\"The Strait!\" --app-version=0.0.1 --build-version=0.0.1 --ignore=\"^/dist\" --ignore=\"^/steam\" --ignore=\"^/[.]claude\" --ignore=\"node_modules/three/(src|docs)\" --ignore=\"node_modules/three/examples/(?!jsm)\" --ignore=\"node_modules/three/examples/jsm/libs\" --prune=true"
  },
  "dependencies": {
    "steamworks.js": "^0.4.0",
    "three": "^0.170.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@electron/packager": "^18.4.4",
    "electron": "^33.4.11"
  },
  "productName": "The Strait!",
  "steamAppId": 480
}
